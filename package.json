{
  "name": "studymate-ai",
  "version": "1.0.0",
  "description": "StudyMate AI - Your Personal AI Study Assistant for university students",
  "type": "module",
  "private": true,
  "workspaces": [
    "client"
  ],
  "scripts": {
    "build": "npm run build --workspace=client",
    "install:all": "npm install && npm install --prefix server && npm install --prefix client",
    "server": "npm start --prefix server",
    "server:dev": "npm run dev --prefix server",
    "client": "npm run dev --prefix client",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"magenta,cyan\" \"npm run server:dev\" \"npm run client\"",
    "build:client": "npm run build --workspace=client"
  },
  "dependencies": {
    "@huggingface/inference": "^4.13.1",
    "dotenv": "^17.3.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "ai",
    "chatbot",
    "studymate",
    "huggingface",
    "education",
    "express",
    "react",
    "tailwind",
    "vercel"
  ],
  "author": "StudyMate Team",
  "license": "MIT"
}
